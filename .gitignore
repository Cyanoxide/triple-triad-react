# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# The export, zipped for upload. Rebuilt on every deploy and never belongs in
# git — it was tracked until 2026-08-07 and is 10MB a copy.
/out.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# serwist — generated at build time from src/app/sw.ts
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# typescript
*.tsbuildinfo
next-env.d.ts

# Working notes for Claude Code sessions — local reference, not project docs
CLAUDE.md
